<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <suppress files=".*Constants\.java" checks="InterfaceIsType"/>
    <suppress files=".*GlobalParam\.java" checks="VisibilityModifier"/>
    <suppress files=".*SentenceSilimarityAttribute\.java" checks="VisibilityModifier"/>
    <suppress files=".*CWRunParam\.java" checks="MemberName|MethodName|ParameterName"/>

    <suppress files=".*zelus-event/.*" checks="LineLength|JavadocMethod|JavadocType|MagicNumber|MethodLength|LocalVariableName|LocalFinalVariableName|Regexp|RedundantModifier|NestedIfDepth|NestedForDepth|VisibilityModifier|HideUtilityClassConstructor|NeedBraces|ModifierOrder|UncommentedMain|ReturnCount|ParameterName|OperatorWrap|NewlineAtEndOfFile|MemberName|LeftCurly|ConstantName|ArrayTypeStyle|FileTabCharacter|MissingSwitchDefault|EqualsHashCode|HiddenField|FinalClass|EmptyBlock"/>
    <suppress files=".*zelus-takahe/.*" checks="LineLength|JavadocMethod|JavadocType|MagicNumber|MethodLength|LocalVariableName|LocalFinalVariableName|Regexp|RedundantModifier|NestedIfDepth|NestedForDepth|VisibilityModifier|HideUtilityClassConstructor|NeedBraces|ModifierOrder|UncommentedMain|ReturnCount|ParameterName|OperatorWrap|NewlineAtEndOfFile|MemberName|LeftCurly|ConstantName|ArrayTypeStyle|FileTabCharacter|MissingSwitchDefault|EqualsHashCode|HiddenField|FinalClass|EmptyBlock"/>
    <suppress files=".*zelus-summary/.*" checks="LineLength|JavadocMethod|JavadocType|MagicNumber|MethodLength|LocalVariableName|LocalFinalVariableName|Regexp|RedundantModifier|NestedIfDepth|NestedForDepth|VisibilityModifier|HideUtilityClassConstructor|NeedBraces|ModifierOrder|UncommentedMain|ReturnCount|ParameterName|OperatorWrap|NewlineAtEndOfFile|MemberName|LeftCurly|ConstantName|ArrayTypeStyle|FileTabCharacter|MissingSwitchDefault|EqualsHashCode|HiddenField|FinalClass|EmptyBlock"/>
