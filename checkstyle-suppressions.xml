<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <suppress files=".*Constants\.java" checks="InterfaceIsType"/>
    <suppress files=".*GlobalParam\.java" checks="VisibilityModifier"/>
    <suppress files=".*SentenceSilimarityAttribute\.java" checks="VisibilityModifier"/>
    <suppress files=".*CWRunParam\.java" checks="MemberName|MethodName|ParameterName"/>

    <suppress files=".*zelus-event/.*" checks="MethodLength|NestedIfDepth|NestedForDepth|ReturnCount|VisibilityModifier|MagicNumber|LineLength|JavadocMethod|JavadocType|LocalVariableName|LocalFinalVariableName|ConstantName|MemberName|ParameterName|OperatorWrap"/>
    <suppress files=".*zelus-takahe/.*" checks="MethodLength|NestedIfDepth|NestedForDepth|ReturnCount|VisibilityModifier|MagicNumber|LineLength|JavadocMethod|JavadocType|LocalVariableName|LocalFinalVariableName|ConstantName|MemberName|ParameterName|OperatorWrap"/>
    <suppress files=".*zelus-summary/.*" checks="MethodLength|NestedIfDepth|NestedForDepth|ReturnCount|VisibilityModifier|MagicNumber|LineLength|JavadocMethod|JavadocType|LocalVariableName|LocalFinalVariableName|ConstantName|MemberName|ParameterName|OperatorWrap"/>
</suppressions>
